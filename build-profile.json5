{
  "app": {
    // 本仓库**不提交签名配置**（历史上曾把 DevEco 自动生成的签名配置——含本机绝对路径
    // 与签名口令——提交进公开历史）。本地开发请在 DevEco Studio 中
    // File → Project Structure → Signing Configs 勾选 “Automatically generate signature”，
    // IDE 会把 signingConfigs 与本文件的 "signingConfig": "default" 自动写回。
    // ⚠️ 写回后请勿提交；本仓库的 .githooks/pre-commit 隐私守卫会拦下这类提交。
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.0.1(21)",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "nativeCompiler": "BiSheng",
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
